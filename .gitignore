# Create .gitignore file (you showed me this content earlier from the Server)
@"
# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/

# Flask
instance/
.env
*.db
*.sqlite

# Documents (don't commit sensitive docs)
documents/assignments/*
documents/returns/*
documents/uploads/*
!documents/assignments/.gitkeep
!documents/returns/.gitkeep
!documents/uploads/.gitkeep

# Database
database/*.db
database/*.sqlite

# IDEs
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini

# Excel
~$*.xlsx
~$*.xls

# Logs
*.log
"@ | Out-File -FilePath .gitignore -Encoding utf8